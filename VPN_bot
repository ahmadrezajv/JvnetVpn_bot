def get_available_config(plan_type):
    try:
        conn = sqlite3.connect(DB_NAME)
        cursor = conn.cursor()
        cursor.execute("""
            SELECT id, config_text 
            FROM vpn_configs 
            WHERE plan_type = ? AND is_used = 0 
            LIMIT 1
        """, (plan_type,))
        row = cursor.fetchone()
        if row:
            config_id, config_text = row
            cursor.execute("UPDATE vpn_configs SET is_used = 1 WHERE id = ?", (config_id,))
            conn.commit()
            conn.close()
            return config_text
        conn.close()
        return None
    except Exception as e:
        print("خطا در get_available_config:", e)
        return None

@bot.message_handler(commands=['start'])
def send_welcome(message):
    user_id = message.chat.id
    username = message.chat.username or "ندارد"
    first_name = message.chat.first_name or "ندارد"
    start_time = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    try:
        conn = sqlite3.connect(DB_NAME)
        cursor = conn.cursor()
        today = datetime.now().strftime("%Y-%m-%d")
        cursor.execute("SELECT COUNT(*) FROM user_starts WHERE user_id = ? AND start_time LIKE ?", (user_id, f"{today}%"))
        if cursor.fetchone()[0] == 0:
            cursor.execute("INSERT INTO user_starts (user_id, username, first_name, start_time) VALUES (?, ?, ?, ?)",
                           (user_id, username, first_name, start_time))
            conn.commit()
        conn.close()
    except Exception as e:
        print(f"خطا در ثبت استارت: {e}")

    markup = telebot.types.ReplyKeyboardMarkup(resize_keyboard=True)
    markup.add("VPN", "Apple ID", "ارتباط با ادمین")
    bot.send_message(message.chat.id, "لطفاً یکی از گزینه‌های زیر را انتخاب کنید:", reply_markup=markup)

