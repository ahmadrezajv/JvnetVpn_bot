@bot.message_handler(commands=['stats_today'])
def stats_today(message):
    if message.chat.id != ADMIN_CHAT_ID:
        return

    today = datetime.now().strftime("%Y-%m-%d")

    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("""
        SELECT COUNT(*) FROM user_starts 
        WHERE start_time LIKE ?
    """, (f"{today}%",))
    count = cursor.fetchone()[0]

    cursor.execute("""
        SELECT user_id, first_name, username, start_time 
        FROM user_starts 
        WHERE start_time LIKE ? 
        ORDER BY start_time DESC
    """, (f"{today}%",))
    records = cursor.fetchall()

    conn.close()

    text = f"آمار استارت امروز ({today}):\nتعداد: {count}\n\n"
    if count > 0:
        text += "لیست:\n"
        for r in records:
            username = f"@{r[2]}" if r[2] else "ندارد"
            text += f"• {r[1]} ({username}) - ID: {r[0]} - {r[3]}\n"
    else:
        text += "امروز هنوز استارتی ثبت نشده."

    bot.reply_to(message, text)

