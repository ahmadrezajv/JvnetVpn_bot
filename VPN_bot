@bot.callback_query_handler(func=lambda call: True)
def callback_handler(call):
    user_id = call.from_user.id

    if call.data == "free_test":
        conn = sqlite3.connect(DB_NAME)
        cursor = conn.cursor()
        cursor.execute("SELECT 1 FROM free_tests WHERE user_id = ?", (user_id,))
        if cursor.fetchone():
            bot.answer_callback_query(call.id, "شما قبلاً تست رایگان گرفتید!", show_alert=True)
            conn.close()
            return

        config = get_available_config("free_test")
        if config:
            bot.send_message(user_id, f"تست رایگان شما:\n\n{config}\n\nاین فقط برای تست است.\nبرای خرید کامل، پلن 12 گیگ را انتخاب کنید.")
            bot.answer_callback_query(call.id, "تست ارسال شد ✓", show_alert=True)
            cursor.execute("INSERT INTO free_tests (user_id, taken_at) VALUES (?, ?)",
                           (user_id, datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
            conn.commit()
        else:
            bot.answer_callback_query(call.id, "تست رایگان موجود نیست!", show_alert=True)
        conn.close()
        return

    if call.data == "vpn_1m_1u_12gb":
        plan_name = "۱ ماهه | ۱ کاربر - 12 گیگ"
        price = "395,۰۰۰ تومان"
        card = "6037997526562229"
        text = f"پلن انتخابی: {plan_name}\nمبلغ: {price}\n\nواریز به:\n{card}"
        bot.edit_message_text(text, call.message.chat.id, call.message.message_id)
        bot.send_message(call.message.chat.id, "عکس رسید را ارسال کنید.")
        user_plans[call.message.chat.id] = call.data
        return

    if call.data.startswith("confirm_"):
        if call.from_user.id != ADMIN_CHAT_ID:
            bot.answer_callback_query(call.id, "شما ادمین نیستید!", show_alert=True)
            return

        try:
            _, uid_str, plan_type = call.data.split("_", 2)
            uid = int(uid_str)

            config = get_available_config(plan_type)
            if config:
                bot.send_message(uid, config, disable_web_page_preview=True)
                bot.send_message(uid, "✅ سفارش تأیید شد!\nپلن: ۱ ماهه | ۱ کاربر - 12 گیگ\nمدت اعتبار: ۳۰ روز\nپشتیبانی: @jvnetvpnn")
                bot.edit_message_caption(call.message.caption + "\n\n✅ تأیید و ارسال شد", call.message.chat.id, call.message.message_id, reply_markup=None)
                bot.answer_callback_query(call.id, "ارسال شد ✓", show_alert=True)
            else:
                bot.answer_callback_query(call.id, "کانفیگ موجود نیست!", show_alert=True)
        except Exception as e:
            print("خطا در تأیید:", e)
            bot.answer_callback_query(call.id, "خطا در پردازش", show_alert=True)

